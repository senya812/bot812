# --- Обязательные ---
BOT_TOKEN=123456:ABC-your-token-from-BotFather
# Один админ или несколько через запятую: все видят одно и то же (каталог, остатки, рассылки).
ADMIN_ID=123456789
# ADMIN_ID=123456789,987654321

# --- Бренд (всё необязательно; видно клиентам) ---
BRAND_NAME=Outfit
BRAND_TAGLINE=Персональный бутик стиля
# Текст страницы «О бренде». Перенос строки — символы \n
BRAND_ABOUT=Мы собираем коллекции, в которых легко чувствовать себя собой.\nЛистайте каталог и складывайте понравившиеся вещи в «Мой образ».
# Кнопка «Написать нам» на странице «О бренде»: @username или https-ссылка. Пусто — кнопки нет
# CONTACT_URL=@your_shop

# --- Вид каталога (необязательно) ---
# carousel — одна карточка, листание кнопками ‹ › (по умолчанию, чат остаётся чистым)
# feed     — все вещи категории сообщениями подряд; кнопка «Назад» удаляет их из чата
# CATALOG_MODE=carousel

# --- Технические (необязательно) ---
# Часовой пояс магазина (часы от UTC) для времени в журнале остатков: 3 — Москва, 2 — Киев/Рига, 1 — Берлин
# TZ_OFFSET=3
# PROXY_URL=socks5://user:pass@host:port
# WELCOME_PHOTO=путь_к_картинке или file_id или https-ссылка   (по умолчанию assets/banner.png)
# DB_PATH=shop.db
